# =============================================================================
# mortaza.ai — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores reais.
# =============================================================================

# --- LLM ---------------------------------------------------------------------
# Profile padrão. Opções:
#   Local (Ollama):    qwen-14b | qwen-7b | qwen-instruct-14b | gemma2-9b | llama3.1-8b
#   Anthropic (Claude): claude-sonnet | claude-haiku | claude-opus
#   Outros cloud:      groq-llama | sabia-3
# Pra WhatsApp recomendo `claude-haiku` (rápido e barato) ou `claude-sonnet`.
MTZCODE_PROFILE=claude-haiku

# Claude API (Anthropic) — obrigatória se usar profile claude-*.
ANTHROPIC_API_KEY=sk-ant-...

# Ollama local — só relevante se for usar profile qwen-* / llama* / gemma2.
# (deixe em branco se Ollama está em localhost:11434 — esse é o default)
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Outros providers opcionais
# GROQ_API_KEY=
# MARITACA_API_KEY=

# Tokens máximos por resposta (Anthropic)
MTZCODE_MAX_TOKENS=4096

# --- Evolution API (WhatsApp) ------------------------------------------------
# URL base da sua instância Evolution (sem barra no final).
EVOLUTION_BASE_URL=http://host.docker.internal:8080

# API key global da Evolution (header `apikey`).
EVOLUTION_API_KEY=cole-sua-apikey-aqui

# Nome da instância que vai mandar/receber mensagens.
EVOLUTION_INSTANCE=minha-instancia

# --- Segurança do webhook ----------------------------------------------------
# Lista de números (E.164 sem +, separados por vírgula) autorizados a falar
# com o bot. Vazio = aceita qualquer um (NÃO recomendado em prod).
WHATSAPP_ALLOWED_NUMBERS=5511999999999

# Header `x-webhook-secret` esperado da Evolution. Configure o mesmo valor
# nas Webhooks da Evolution. Vazio = sem verificação.
WHATSAPP_WEBHOOK_SECRET=

# Auto-confirma tools destrutivas (edit/write/bash sem prompt). true só
# se você é o único usuário e confia 100% nos contatos autorizados.
WHATSAPP_AUTO_CONFIRM=false

# Diretório raiz dos workspaces (cada contato ganha uma subpasta).
MTZCODE_WHATSAPP_ROOT=/app/workspace

# --- Porta do bot ------------------------------------------------------------
BOT_PORT=8000
